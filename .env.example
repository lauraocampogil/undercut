# ── Everything is optional: without keys the app runs in "demo mode" ──

# Public URL of the app (used in links)
PUBLIC_APP_URL=http://localhost:5173

# Supabase (without it: database in data/db.json and login without verification)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Search engine used to discover competitors (set one of the two)
SERPAPI_KEY=
BRAVE_SEARCH_KEY=

# Optional LLM for better search queries
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Email (without it: the weekly summary is printed in the console)
RESEND_API_KEY=
EMAIL_FROM=Undercut <hello@yourdomain.com>

# Protects the daily cron endpoint
CRON_SECRET=change-me

# Analytics: PostHog (EU Cloud). Loads only after the visitor accepts cookies.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Error monitoring: Sentry. Leave empty to disable.
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENVIRONMENT=development

# Development only: simulates Shopify stores and search with  npm run fake-shopify
# FAKE_SHOPIFY_URL=http://localhost:4545

# Build time only (Vercel): upload source maps to Sentry
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
