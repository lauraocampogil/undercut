# Google OAuth (Google Cloud Console → Credentials → OAuth client ID → Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional, defaults to <origin>/auth/google/callback
GOOGLE_REDIRECT_URI=

# Optional: AI weekly summaries (falls back to rule-based summaries)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: Ideas module — Google Trends + top-ranking content (serpapi.com, free tier 100 searches/month)
SERPAPI_KEY=

# Optional: PageSpeed Insights key (the SEO audit works without one, with a lower quota)
PAGESPEED_API_KEY=

# Public URL of this app — used in the tracking snippet, emails and Google sign-in.
PUBLIC_BASE_URL=http://localhost:5173
# Production (node build / Docker): the same public URL, so forms and Google sign-in work behind a proxy
ORIGIN=
# Signs login cookies (generated into .data/secret.txt if empty). In production: openssl rand -hex 32
SESSION_SECRET=
# Self-hosting: built-in timer sends daily alerts + Monday digest. Set to "off" if you use /api/cron instead.
SCHEDULER=

# Optional: real monthly search volumes + competition in Keyword research (dataforseo.com, pay as you go)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional: Stripe billing (Settings → Billing & usage)
STRIPE_SECRET_KEY=
STRIPE_PRICE_FREELANCE=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_STUDIO=

# Optional: alert & weekly digest emails (resend.com). Slack works with just a webhook URL in Settings → Alerts.
RESEND_API_KEY=
ALERTS_FROM=Undercut <alerts@yourdomain.be>
# Protects /api/cron (set the same value in Vercel; Vercel Cron sends it as a Bearer token)
CRON_SECRET=
