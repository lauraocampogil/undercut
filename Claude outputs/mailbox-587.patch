From f0d7b09484a7b854a8588fba6e33130397ce88d5 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 23 Nov 2026 12:17:27 +0100
Subject: [PATCH] Mailbox: SMTP on 587 (STARTTLS) by default, Hetzner blocks
 outgoing 465 on new servers

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019MkVpnoyjaaakp7yQiE2ks
---
 src/lib/server/mailbox.ts            | 9 +++++----
 src/routes/app/settings/+page.svelte | 2 +-
 2 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/src/lib/server/mailbox.ts b/src/lib/server/mailbox.ts
index b8633c0..6e93b07 100644
--- a/src/lib/server/mailbox.ts
+++ b/src/lib/server/mailbox.ts
@@ -1,3 +1,4 @@
+// Port 587 (STARTTLS) by default: some hosts (e.g. Hetzner) block outgoing 465 on new servers.
 // The agency's own mailbox (Gmail, iCloud, Yahoo, or any IMAP/SMTP provider), connected with an app password.
 // Undercut sends the first messages and follow-ups from it, and reads the inbox to see who replied:
 // the card moves to "Replied" by itself and the follow-ups stop. The password is stored encrypted, never sent back to the browser.
@@ -22,9 +23,9 @@ type Box = {
 };
 const FILE = 'mailbox.json';
 export const PRESETS: Record<Exclude<Provider, 'other'>, { smtp: { host: string; port: number }; imap: { host: string; port: number } }> = {
-	gmail: { smtp: { host: 'smtp.gmail.com', port: 465 }, imap: { host: 'imap.gmail.com', port: 993 } },
+	gmail: { smtp: { host: 'smtp.gmail.com', port: 587 }, imap: { host: 'imap.gmail.com', port: 993 } },
 	icloud: { smtp: { host: 'smtp.mail.me.com', port: 587 }, imap: { host: 'imap.mail.me.com', port: 993 } },
-	yahoo: { smtp: { host: 'smtp.mail.yahoo.com', port: 465 }, imap: { host: 'imap.mail.yahoo.com', port: 993 } }
+	yahoo: { smtp: { host: 'smtp.mail.yahoo.com', port: 587 }, imap: { host: 'imap.mail.yahoo.com', port: 993 } }
 };
 
 // ---------- the password, encrypted at rest ----------
@@ -49,7 +50,7 @@ export function mailboxInfo() {
 	return b ? { email: b.email, provider: b.provider, connectedAt: b.connectedAt, lastSync: b.lastSync, lastError: b.lastError } : null;
 }
 
-const transport = (b: Box, pass: string) => nodemailer.createTransport({ host: b.smtp.host, port: b.smtp.port, secure: b.smtp.port === 465, auth: { user: b.email, pass }, connectionTimeout: 15000 });
+const transport = (b: Box, pass: string) => nodemailer.createTransport({ host: b.smtp.host, port: b.smtp.port, secure: b.smtp.port === 465, requireTLS: b.smtp.port !== 465, auth: { user: b.email, pass }, connectionTimeout: 15000 });
 const imapClient = (b: Box, pass: string) => new ImapFlow({ host: b.imap.host, port: b.imap.port, secure: true, auth: { user: b.email, pass }, logger: false, socketTimeout: 30000 });
 
 /** Check both sending and reading work, then save. */
@@ -62,7 +63,7 @@ export async function connectMailbox(input: { email: string; pass: string; provi
 		email,
 		name: input.name,
 		provider: input.provider,
-		smtp: preset?.smtp ?? { host: input.smtpHost ?? '', port: input.smtpPort || 465 },
+		smtp: preset?.smtp ?? { host: input.smtpHost ?? '', port: input.smtpPort || 587 },
 		imap: preset?.imap ?? { host: input.imapHost ?? '', port: input.imapPort || 993 },
 		pass: '',
 		connectedAt: new Date().toISOString()
diff --git a/src/routes/app/settings/+page.svelte b/src/routes/app/settings/+page.svelte
index 6f8e0e9..5698927 100644
--- a/src/routes/app/settings/+page.svelte
+++ b/src/routes/app/settings/+page.svelte
@@ -53,7 +53,7 @@
 					{#if provider === 'other'}
 						<div class="grid grid-cols-[1fr_90px] gap-2">
 							<label class="text-sm"><span class="label">{t.smtpHost}</span><input name="smtpHost" placeholder="smtp.example.be" class="input mt-1.5" /></label>
-							<label class="text-sm"><span class="label">{t.port}</span><input name="smtpPort" inputmode="numeric" placeholder="465" class="input mt-1.5" /></label>
+							<label class="text-sm"><span class="label">{t.port}</span><input name="smtpPort" inputmode="numeric" placeholder="587" class="input mt-1.5" /></label>
 							<label class="text-sm"><span class="label">{t.imapHost}</span><input name="imapHost" placeholder="imap.example.be" class="input mt-1.5" /></label>
 							<label class="text-sm"><span class="label">{t.port}</span><input name="imapPort" inputmode="numeric" placeholder="993" class="input mt-1.5" /></label>
 						</div>
-- 
