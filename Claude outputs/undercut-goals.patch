+			<div class="mt-4 h-3 overflow-hidden rounded-full bg-tile"><div class="h-full rounded-full {p.status === 'behind' ? 'bg-ink' : 'bg-accent'}" style="width:{Math.max(2, p.pct)}%"></div></div>
