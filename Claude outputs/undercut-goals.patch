+					<p class="mt-2 flex flex-wrap items-baseline gap-x-3"><span class="big text-[52px]">{fmt(p.current, p.money)}</span><span class="text-xl text-muted">/ {fmt(p.goal.target, p.money)} {p.money ? '' : p.unit}</span></p>
