+// Interface sounds, synthesised with Web Audio (no files): a soft tick on hover, a click, a "found" chime.
+// Off by default until the visitor turns it on; remembered per browser. Respects reduced motion.
+const KEY = 'uc-sound';
+export const sound = $state({ on: false });
+
+let ctx: AudioContext | null = null;
+let last = 0;
+
+export function initSound() {
+	try {
+		sound.on = localStorage.getItem(KEY) === '1' && !matchMedia('(prefers-reduced-motion: reduce)').matches;
+	} catch {
+		/* storage blocked */
+	}
+}
+export function toggleSound() {
+	sound.on = !sound.on;
+	try {
+		localStorage.setItem(KEY, sound.on ? '1' : '0');
+	} catch {
+		/* ignore */
+	}
+	if (sound.on) play('on');
+}
+
+function ac() {
+	if (!ctx) ctx = new (window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext)();
+	if (ctx.state === 'suspended') ctx.resume();
+	return ctx;
+}
+
+function blip(freq: number, dur: number, gain: number, type: OscillatorType = 'sine', at = 0, slide?: number) {
+	const c = ac();
+	const t = c.currentTime + at;
+	const o = c.createOscillator();
+	const g = c.createGain();
+	o.type = type;
+	o.frequency.setValueAtTime(freq, t);
+	if (slide) o.frequency.exponentialRampToValueAtTime(slide, t + dur);
+	g.gain.setValueAtTime(0.0001, t);
+	g.gain.exponentialRampToValueAtTime(gain, t + 0.004);
+	g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
+	o.connect(g).connect(c.destination);
+	o.start(t);
+	o.stop(t + dur + 0.02);
+}
+
+export type Sfx = 'tick' | 'click' | 'found' | 'on' | 'error';
+export function play(kind: Sfx) {
+	if (!sound.on || typeof window === 'undefined') return;
+	const now = performance.now();
+	if (kind === 'tick' && now - last < 45) return; // no machine-gun ticks
+	last = now;
+	try {
+		if (kind === 'tick') blip(2400, 0.035, 0.035, 'triangle');
+		else if (kind === 'click') blip(900, 0.06, 0.08, 'triangle', 0, 520);
+		else if (kind === 'on') (blip(660, 0.08, 0.06), blip(990, 0.1, 0.05, 'sine', 0.07));
+		else if (kind === 'found') [523, 659, 784, 1046].forEach((f, i) => blip(f, 0.16, 0.05, 'sine', i * 0.07));
+		else if (kind === 'error') blip(220, 0.18, 0.07, 'square', 0, 160);
+	} catch {
+		/* audio unavailable */
+	}
+}
+
+/** Global: tick when hovering buttons/links, click on press. Opt out with data-silent. */
+export function soundDelegation(root: HTMLElement) {
+	const sel = 'a[href],button,[role="button"],summary,label[for],input[type="checkbox"],input[type="radio"]';
+	const over = (e: PointerEvent) => {
+		if (e.pointerType !== 'mouse') return;
+		const el = (e.target as HTMLElement).closest(sel);
+		if (el && !el.closest('[data-silent]') && !(el as HTMLElement).contains(e.relatedTarget as Node)) play('tick');
+	};
+	const down = (e: PointerEvent) => {
+		const el = (e.target as HTMLElement).closest(sel);
+		if (el && !el.closest('[data-silent]')) play('click');
+	};
+	root.addEventListener('pointerover', over);
+	root.addEventListener('pointerdown', down);
+	return { destroy: () => (root.removeEventListener('pointerover', over), root.removeEventListener('pointerdown', down)) };
+}
