+/** The dashboard Undercut builds from what it read on the agency's site. */
+export function layoutFor(p: AgencyProfile) {
+	const has = (x: string) => p.services.includes(x as never);
+	const social = has('social') && !has('web') && !has('seo');
+	const app = has('app') && !has('web');
+	const kind = social ? 'Social media & communication agency' : app ? 'App studio' : has('branding') && !has('web') ? 'Branding studio' : 'Web agency';
+	let order: BlockId[];
+	const blocks = Object.fromEntries(BLOCKS.map((b) => [b.id, true])) as Record<BlockId, boolean>;
+	const sizes: Partial<Record<BlockId, Size>> = { ...DEFAULT_SIZE };
+	const why: string[] = [];
+	if (social) {
+		order = ['prospects', 'content', 'pipeline', 'todo', 'clients', 'calendar', 'goals', 'site'];
+		sizes.content = 's';
+		blocks.site = false;
+		why.push('Prospects with weak Instagram / TikTok', 'What to post this week', 'Pipeline and agenda', 'Your clients’ results');
+	} else if (app) {
+		order = ['clients', 'prospects', 'pipeline', 'todo', 'calendar', 'goals', 'site', 'content'];
+		blocks.content = false;
+		why.push('Your clients’ apps first: users, crashes, reviews', 'Businesses without an app or online booking', 'Pipeline and agenda');
+	} else {
+		order = ['prospects', 'pipeline', 'todo', 'calendar', 'clients', 'site', 'goals', 'content'];
+		blocks.content = false;
+		why.push('Businesses whose website needs you', 'Pipeline and agenda', 'Your clients’ sites: leads, Google, fixes', 'Your own site’s health');
+	}
+	return { kind, order, blocks, sizes, why };
+}
+
 export function setProfile(profile: AgencyProfile) {
 	const s = getOS();
+	const first = !s.profile;
 	s.profile = profile;
+	// build (or rebuild) the dashboard for this agency, unless the user already arranged it
+	if (!s.custom) {
+		const l = layoutFor(profile);
+		s.order = l.order;
+		s.blocks = l.blocks;
+		s.sizes = l.sizes;
+		s.built = { at: new Date().toISOString(), kind: l.kind, why: l.why, seen: first ? false : s.built?.seen };
+	}
 	// the dashboard takes the colour of the agency's site, unless the user picked one
 	if (profile.color && !s.theme.picked) s.theme = { accent: profile.color };
 	saveOS(s);
@@ -146,6 +184,7 @@ export function applyAsk(text: string): string {
 	else if (show || first) s.blocks[match.id] = true;
 	if (first) s.order = [match.id, ...s.order.filter((b) => b !== match.id)];
 	if (!hide && !show && !first) s.blocks[match.id] = !s.blocks[match.id];
+	s.custom = true;
 	saveOS(s);
 	return `${s.blocks[match.id] ? 'Showing' : 'Hiding'} “${match.label}”${first ? ' at the top' : ''}.`;
 }
