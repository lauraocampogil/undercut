diff --git a/src/routes/layout.css b/src/routes/layout.css
index eb01c34..0fdea40 100644
--- a/src/routes/layout.css
+++ b/src/routes/layout.css
@@ -644,3 +644,34 @@ html {
 .night .dock a.bg-ink span {
 	background: rgb(0 0 0 / 0.08);
 }
+
+/* button hover: the label rolls up and the same label comes in from below (the button itself stays still) */
+.roll {
+	position: relative;
+	display: inline-block;
+	overflow: hidden;
+	vertical-align: top;
+	line-height: 1.25;
+}
+.roll > span {
+	display: inline-block;
+	transition: transform 0.45s cubic-bezier(0.2, 0.75, 0.15, 1);
+}
+.roll::after {
+	content: attr(data-t);
+	position: absolute;
+	left: 0;
+	top: 100%;
+	white-space: nowrap;
+	transition: transform 0.45s cubic-bezier(0.2, 0.75, 0.15, 1);
+}
+:is(a, button):hover .roll > span,
+:is(a, button):hover .roll::after {
+	transform: translateY(-100%);
+}
+@media (prefers-reduced-motion: reduce) {
+	.roll > span,
+	.roll::after {
+		transition: none;
+	}
+}
