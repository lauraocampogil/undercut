+
+/* letters rising out of a blur */
+.js .chars .ch {
+	display: inline-block;
+	opacity: 0;
+	filter: blur(10px);
+	transform: translateY(0.35em);
+	transition:
+		opacity 0.7s var(--ease-out),
+		filter 0.8s var(--ease-out),
+		transform 0.9s var(--ease-out);
+	transition-delay: calc(var(--d, 0ms) + var(--i) * var(--st, 22ms));
+}
+.js .chars.in .ch {
+	opacity: 1;
+	filter: none;
+	transform: none;
+}
+/* cursor light on glass */
+.spot {
+	position: relative;
+	isolation: isolate;
+}
+.spot::after {
+	content: '';
+	position: absolute;
+	inset: 0;
+	border-radius: inherit;
+	pointer-events: none;
+	background: radial-gradient(260px circle at var(--sx, -300px) var(--sy, -300px), rgb(255 255 255 / 0.55), transparent 60%);
+	opacity: 0;
+	transition: opacity 0.3s;
+	z-index: 1;
+	mix-blend-mode: soft-light;
+}
+.spot:hover::after {
+	opacity: 1;
+}
+.card-dark.spot::after {
+	background: radial-gradient(260px circle at var(--sx, -300px) var(--sy, -300px), rgb(255 255 255 / 0.12), transparent 60%);
+	mix-blend-mode: normal;
+}
+.has-cursor body,
+.has-cursor a,
+.has-cursor button {
+	cursor: none;
+}
+.has-cursor input,
+.has-cursor textarea {
+	cursor: text;
+}
+@keyframes scan {
+	from {
+		transform: translateY(-100%);
+	}
+	to {
+		transform: translateY(100%);
+	}
+}
+@keyframes blink {
+	50% {
+		opacity: 0;
+	}
+}
+.caret::after {
+	content: '_';
+	animation: blink 1s steps(1) infinite;
+}
+@media (prefers-reduced-motion: reduce) {
+	.js .chars .ch {
+		opacity: 1 !important;
+		filter: none !important;
+		transform: none !important;
+	}
+}
