+<script lang="ts">
+	import { enhance } from '$app/forms';
+	import { act } from '#lib/act.ts';
+	import { eur } from '#lib/biz-format.ts';
+	let { data } = $props();
+
+	type Card = (typeof data.waiting)[number];
+	let showLost = $state(false);
+	const keep = () => async ({ update }: { update: (o?: { reset?: boolean }) => Promise<void> }) => update({ reset: false });
+	const DAY = 86400000;
+	const ago = (d?: string) => {
+		if (!d) return '';
+		const n = Math.round((Date.now() - new Date(d + 'T12:00:00').getTime()) / DAY);
+		return n <= 0 ? 'Today' : n === 1 ? 'Yesterday' : `${n} days`;
+	};
+	const day = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('en-GB', { weekday: 'long' });
+	const waitingLine = (c: Card) => {
+		if (!c.next) return 'Waiting for their answer';
+		if (c.followups >= 2) return `Last follow-up sent · moves to Not now on ${day(c.next)}`;
+		return `Follow-up ${c.followups + 1} on ${day(c.next)}${c.followups ? ' · last one after that' : ''}`;
+	};
+	const cols = $derived([
+		{ key: 'waiting', title: 'Waiting for a reply', hint: 'Undercut follows up', cards: data.waiting, empty: 'Messages you send from Today land here.' },
+		{ key: 'replied', title: 'Replied', hint: 'Your turn', cards: data.replied, empty: 'When someone answers, tap “They replied” on their card.' },
+		{ key: 'won', title: 'Clients', hint: 'Won', cards: data.won, empty: 'Signed clients show up here.' }
+	]);
+</script>
+
+<svelte:head><title>Pipeline · Undercut</title></svelte:head>
+
+<h1 class="text-[34px] leading-[1.1] font-semibold sm:text-[40px]">Pipeline</h1>
+<p class="mt-1.5 text-ink-2">
+	Everyone you wrote to, in three steps. Undercut follows up for you; move a card when someone answers.
+	{#if data.toSend}<a href="/app" class="font-medium text-accent hover:underline">{data.toSend} found and waiting in Today →</a>{/if}
+</p>
+
+<div class="mt-7 grid items-start gap-5 [grid-template-columns:repeat(auto-fit,minmax(300px,1fr))]">
+	{#each cols as col (col.key)}
+		<section class="rounded-[20px] bg-tile p-3.5" aria-label={col.title}>
+			<div class="flex items-baseline justify-between px-1.5 pt-1 pb-3">
+				<h2 class="font-semibold">{col.title} <span class="font-medium text-muted">{col.cards.length}</span></h2>
+				<span class="text-[12.5px] text-ink-2">{col.hint}</span>
+			</div>
+			<div class="flex flex-col gap-2.5">
+				{#each col.cards as c (c.id)}
+					<article class="flex flex-col gap-1.5 rounded-[14px] border border-line bg-white px-4 py-3.5">
+						<div class="flex items-baseline justify-between gap-2">
+							<h3 class="min-w-0 truncate font-semibold">{c.name}</h3>
+							<span class="text-[12.5px] whitespace-nowrap text-muted">{col.key === 'waiting' ? (ago(c.contactedAt) === 'Today' ? 'Sent today' : ago(c.contactedAt)) : col.key === 'replied' ? ago(c.updatedAt) : `Since ${new Date(c.updatedAt + 'T12:00:00').toLocaleDateString('en-GB', { month: 'short' })}`}</span>
+						</div>
+						<p class="text-[13.5px] text-ink-2">
+							{#if col.key === 'waiting'}{waitingLine(c)}
+							{:else if col.key === 'replied'}{c.note || c.category}
+							{:else}{[c.category, c.value ? `${eur(c.value)}/month` : ''].filter(Boolean).join(' · ')}{/if}
+						</p>
+						<div class="mt-1 flex flex-wrap items-center gap-2">
+							{#if col.key === 'waiting'}
+								<form method="POST" action={act('stage')} use:enhance={keep}><input type="hidden" name="id" value={c.id} /><button name="stage" value="talking" class="min-h-10 rounded-[10px] bg-accent-soft px-3.5 text-sm font-semibold text-accent">They replied</button></form>
