@@ -0,0 +1,101 @@
+<script lang="ts">
+	// First run: 3 questions, then Undercut finds the first 5 businesses right away.
+	import { enhance } from '$app/forms';
+	import { act } from '#lib/act.ts';
+	type Profile = { url: string; name: string; city: string; services: string[]; target: string } | null;
+	let { profile, error = '' }: { profile: Profile; error?: string } = $props();
+
+	const SERVICES = [
+		['web', 'Websites'],
+		['branding', 'Branding'],
+		['social', 'Social media'],
+		['seo', 'SEO'],
+		['ads', 'Ads'],
+		['video', 'Photo & video'],
+		['app', 'Apps']
+	] as const;
+	const TARGETS = [
+		['small', 'Small local shops', 'Bakeries, salons, cafés, independents'],
+		['big', 'Bigger companies', 'Hotels, clinics, law and accounting firms'],
+		['any', 'Both', 'Best match first']
+	] as const;
+
+	let busy = $state(false);
+	let si = $state(0);
+	const steps = $derived(['Reading your site…', `Looking around ${profile?.city || 'your city'}…`, 'Checking each business…', 'Writing the messages in their language…', 'Almost there…']);
+	$effect(() => {
+		if (!busy) return;
+		si = 0;
+		const t = setInterval(() => (si = Math.min(steps.length - 1, si + 1)), 4000);
+		return () => clearInterval(t);
+	});
+	const SVC: Record<string, string> = Object.fromEntries(SERVICES);
+</script>
+
+<div class="mx-auto max-w-[640px]">
+	<p class="text-sm text-muted">Takes 1 minute</p>
+	<h1 class="mt-1.5 text-[34px] leading-[1.1] font-semibold sm:text-[40px]">Who should we find for you?</h1>
+	<p class="mt-2.5 text-ink-2">Undercut reads your site or profile, then looks for local businesses that need exactly what you sell.</p>
+
+	<form
+		method="POST"
+		action={act('start')}
+		class="mt-7 flex flex-col gap-4"
+		use:enhance={() => {
+			busy = true;
+			return async ({ update }) => {
+				await update({ reset: false });
+				busy = false;
+			};
+		}}
+	>
+		<div class="card p-5 sm:p-6">
+			<label for="start-url" class="flex items-center gap-2.5 font-semibold"><span class="grid size-[26px] place-items-center rounded-full bg-ink text-[13px] text-white">1</span>Your website, Instagram, TikTok or LinkedIn</label>
+			<input id="start-url" name="url" value={profile?.url ?? ''} required inputmode="url" placeholder="youragency.be or instagram.com/youragency" class="input mt-3 !min-h-12 text-base" />
+			{#if profile}
+				<p class="mt-2.5 flex items-center gap-1.5 text-[13px] text-good">
+					<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
+					Found: {profile.name}{profile.city ? `, ${profile.city}` : ''}{profile.services.length ? ` · ${profile.services.map((s) => SVC[s] ?? s).join(', ').toLowerCase()}` : ''}
+				</p>
+			{/if}
+		</div>
+
+		<fieldset class="card p-5 sm:p-6">
+			<legend class="sr-only">What do you sell?</legend>
+			<p class="flex flex-wrap items-center gap-2.5 font-semibold" aria-hidden="true"><span class="grid size-[26px] place-items-center rounded-full bg-ink text-[13px] text-white">2</span>What do you sell? <span class="text-[13px] font-normal text-muted">{profile ? 'We guessed, fix it if needed' : 'We’ll guess from your site if you skip this'}</span></p>
+			<input type="hidden" name="servicesSent" value="1" />
+			<div class="mt-3.5 flex flex-wrap gap-2">
+				{#each SERVICES as [k, l] (k)}
+					<label class="cursor-pointer">
+						<input type="checkbox" name="services" value={k} checked={profile?.services.includes(k) ?? false} class="peer sr-only" />
+						<span class="inline-flex min-h-11 items-center rounded-full border border-[#D6D3C8] bg-white px-4 peer-checked:border-ink peer-checked:bg-ink peer-checked:font-medium peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-accent">{l}</span>
+					</label>
+				{/each}
+			</div>
+		</fieldset>
+
+		<fieldset class="card p-5 sm:p-6">
+			<legend class="sr-only">Which clients do you want?</legend>
+			<p class="flex items-center gap-2.5 font-semibold" aria-hidden="true"><span class="grid size-[26px] place-items-center rounded-full bg-ink text-[13px] text-white">3</span>Which clients do you want?</p>
+			<div class="mt-3.5 grid gap-2.5 sm:grid-cols-3">
+				{#each TARGETS as [k, l, help] (k)}
+					<label class="cursor-pointer">
+						<input type="radio" name="target" value={k} checked={(profile?.target ?? 'small') === k} class="peer sr-only" />
+						<span class="flex h-full flex-col gap-0.5 rounded-[14px] border border-[#D6D3C8] p-3.5 peer-checked:border-2 peer-checked:border-accent peer-checked:bg-[#F0F2FC] peer-focus-visible:outline-2 peer-focus-visible:outline-accent">
+							<span class="font-semibold">{l}</span>
+							<span class="text-[13px] text-ink-2">{help}</span>
+						</span>
+					</label>
+				{/each}
+			</div>
+			<div class="mt-4 flex flex-wrap items-center gap-2.5">
+				<label for="start-city" class="font-medium">Around</label>
+				<input id="start-city" name="city" value={profile?.city ?? ''} placeholder={profile ? 'Your city' : 'Detected from your site, or type it'} class="input min-w-0 flex-1 basis-40" />
+			</div>
+		</fieldset>
+
+		{#if error}<p class="rounded-[14px] bg-warn-bg p-4 text-sm text-warn" role="alert">{error}</p>{/if}
+		<button class="flex min-h-14 items-center justify-center rounded-[14px] bg-accent text-base font-semibold text-white hover:bg-[#1E36A0] disabled:opacity-80" disabled={busy}>{busy ? steps[si] : 'Find my first 5 clients'}</button>
+		<p class="text-center text-[13px] text-muted">{busy ? 'This takes up to a minute: every business is checked before you see it.' : 'You’ll see each business and its message before anything is sent.'}</p>
+	</form>
+</div>
